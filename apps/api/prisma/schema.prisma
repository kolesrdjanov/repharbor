generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions UserSession[]
  invitationsSent Invitation[] @relation("InvitationsSent")
  invitationsAccepted Invitation[] @relation("InvitationsAccepted")
  memberships CompanyFounder[]
  engagements Engagement[]
  proposedAgreements AgreementVersion[] @relation("ProposedAgreements")
  acceptedAgreements AgreementVersion[] @relation("AcceptedAgreements")

  @@map("app_user")
}

model Company {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  timeZone String @map("time_zone")
  founders CompanyFounder[]
  products Product[]

  @@map("company")
}

model CompanyFounder {
  companyId String @map("company_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      AppUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, userId])
  @@index([userId, companyId], map: "founder_by_user")
  @@map("company_founder")
}

model Product {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  engagements Engagement[]

  @@unique([companyId, id])
  @@map("product")
}

model Engagement {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  repId     String? @map("rep_id") @db.Uuid
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(6)
  product   Product @relation(fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  rep       AppUser? @relation(fields: [repId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agreements AgreementVersion[]
  invitations Invitation[]

  @@unique([companyId, id])
  @@unique([companyId, productId, id])
  @@index([repId, id], map: "engagement_by_rep")
  @@map("engagement")
}

model AgreementVersion {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  engagementId      String @map("engagement_id") @db.Uuid
  revision          Int
  rateBps           Int @map("rate_bps")
  accrualMode       String @map("accrual_mode")
  basis             String
  eligibilityMonths Int @map("eligibility_months")
  refundPolicy      String @map("refund_policy")
  cadence           String
  dueDay            Int @map("due_day")
  timeZone          String @map("time_zone")
  effectiveAt       DateTime @map("effective_at") @db.Timestamptz(6)
  proposedBy        String @map("proposed_by") @db.Uuid
  founderAcceptedAt DateTime @map("founder_accepted_at") @db.Timestamptz(6)
  repAcceptedAt     DateTime? @map("rep_accepted_at") @db.Timestamptz(6)
  acceptedByRep     String? @map("accepted_by_rep") @db.Uuid
  engagement        Engagement @relation(fields: [engagementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proposer          AppUser @relation("ProposedAgreements", fields: [proposedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acceptingRep      AppUser? @relation("AcceptedAgreements", fields: [acceptedByRep], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([engagementId, revision])
  @@unique([engagementId, id])
  @@map("agreement_version")
}

model LoginLink {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  tokenDigest  Bytes @unique @map("token_digest")
  returnPath   String? @map("return_path")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  invitationId String? @map("invitation_id") @db.Uuid
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiresAt], map: "login_link_by_expiry")
  @@map("login_link")
}

model UserSession {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String @map("user_id") @db.Uuid
  tokenDigest         Bytes @unique @map("token_digest")
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  pendingInvitationId String? @map("pending_invitation_id") @db.Uuid
  user                AppUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pendingInvitation   Invitation? @relation(fields: [pendingInvitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiresAt], map: "user_session_by_expiry")
  @@map("user_session")
}

model Invitation {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId     String @map("sender_id") @db.Uuid
  email        String
  direction    String
  engagementId String? @map("engagement_id") @db.Uuid
  tokenDigest  Bytes @unique @map("token_digest")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedBy   String? @map("accepted_by") @db.Uuid
  sender       AppUser @relation("InvitationsSent", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipient    AppUser? @relation("InvitationsAccepted", fields: [acceptedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loginLinks   LoginLink[]
  sessions     UserSession[]

  @@map("invitation")
}

model Job {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          String
  dedupeKey     String @unique @map("dedupe_key")
  args          Json
  state         String
  runAfter      DateTime @default(now()) @map("run_after") @db.Timestamptz(6)
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken    String? @map("lease_token") @db.Uuid
  attempts      Int @default(0)
  lastErrorCode String? @map("last_error_code")

  @@map("job")
}

model AuthRateLimit {
  key       String @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int

  @@index([expiresAt], map: "auth_rate_limit_by_expiry")
  @@map("auth_rate_limit")
}
