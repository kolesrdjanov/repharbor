generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions UserSession[]
  decisions Claim[]
  resolvedReviews ReviewItem[]
  auditEvents AuditEvent[]
  idempotencyRecords IdempotencyRecord[]
  invitationsSent Invitation[] @relation("InvitationsSent")
  invitationsAccepted Invitation[] @relation("InvitationsAccepted")
  memberships CompanyFounder[]
  engagements Engagement[]
  proposedAgreements AgreementVersion[] @relation("ProposedAgreements")
  acceptedAgreements AgreementVersion[] @relation("AcceptedAgreements")

  @@map("app_user")
}

model Company {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  timeZone String @map("time_zone")
  founders CompanyFounder[]
  products Product[]
  connections Connection[]
  auditEvents AuditEvent[]

  @@map("company")
}

model CompanyFounder {
  companyId String @map("company_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      AppUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, userId])
  @@index([userId, companyId], map: "founder_by_user")
  @@map("company_founder")
}

model Product {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  engagements Engagement[]
  mappings ProductMapping[]
  authorities SourceAuthority[]

  @@unique([companyId, id])
  @@map("product")
}

model Engagement {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  repId     String? @map("rep_id") @db.Uuid
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(6)
  product   Product @relation(fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  rep       AppUser? @relation(fields: [repId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agreements AgreementVersion[]
  claims Claim[]
  invitations Invitation[]

  @@unique([companyId, id])
  @@unique([companyId, productId, id])
  @@index([repId, id], map: "engagement_by_rep")
  @@map("engagement")
}

model AgreementVersion {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  engagementId      String @map("engagement_id") @db.Uuid
  revision          Int
  rateBps           Int @map("rate_bps")
  accrualMode       String @map("accrual_mode")
  basis             String
  eligibilityMonths Int @map("eligibility_months")
  refundPolicy      String @map("refund_policy")
  cadence           String
  dueDay            Int @map("due_day")
  timeZone          String @map("time_zone")
  effectiveAt       DateTime @map("effective_at") @db.Timestamptz(6)
  proposedBy        String @map("proposed_by") @db.Uuid
  founderAcceptedAt DateTime @map("founder_accepted_at") @db.Timestamptz(6)
  repAcceptedAt     DateTime? @map("rep_accepted_at") @db.Timestamptz(6)
  acceptedByRep     String? @map("accepted_by_rep") @db.Uuid
  engagement        Engagement @relation(fields: [engagementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proposer          AppUser @relation("ProposedAgreements", fields: [proposedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acceptingRep      AppUser? @relation("AcceptedAgreements", fields: [acceptedByRep], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([engagementId, revision])
  @@unique([engagementId, id])
  @@map("agreement_version")
}

model LoginLink {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  tokenDigest  Bytes @unique @map("token_digest")
  returnPath   String? @map("return_path")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  invitationId String? @map("invitation_id") @db.Uuid
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiresAt], map: "login_link_by_expiry")
  @@map("login_link")
}

model UserSession {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String @map("user_id") @db.Uuid
  tokenDigest         Bytes @unique @map("token_digest")
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  pendingInvitationId String? @map("pending_invitation_id") @db.Uuid
  user                AppUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pendingInvitation   Invitation? @relation(fields: [pendingInvitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiresAt], map: "user_session_by_expiry")
  @@map("user_session")
}

model Invitation {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId     String @map("sender_id") @db.Uuid
  email        String
  direction    String
  engagementId String? @map("engagement_id") @db.Uuid
  tokenDigest  Bytes @unique @map("token_digest")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedBy   String? @map("accepted_by") @db.Uuid
  sender       AppUser @relation("InvitationsSent", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipient    AppUser? @relation("InvitationsAccepted", fields: [acceptedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loginLinks   LoginLink[]
  sessions     UserSession[]

  @@map("invitation")
}

model Job {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          String
  dedupeKey     String @unique @map("dedupe_key")
  args          Json
  state         String
  runAfter      DateTime @default(now()) @map("run_after") @db.Timestamptz(6)
  leaseUntil    DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken    String? @map("lease_token") @db.Uuid
  attempts      Int @default(0)
  lastErrorCode String? @map("last_error_code")

  @@map("job")
}

model AuthRateLimit {
  key       String @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int

  @@index([expiresAt], map: "auth_rate_limit_by_expiry")
  @@map("auth_rate_limit")
}

model Claim {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String @map("company_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  engagementId  String @map("engagement_id") @db.Uuid
  customerLabel String @map("customer_label")
  contactEmail  String? @map("contact_email")
  customerKey   String? @default(dbgenerated()) @map("customer_key")
  status        String
  reason        String?
  decidedBy     String? @map("decided_by") @db.Uuid
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  engagement    Engagement @relation(fields: [companyId, productId, engagementId], references: [companyId, productId, id], onDelete: NoAction, onUpdate: NoAction)
  decider       AppUser? @relation(fields: [decidedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, productId, id])
  @@unique([engagementId, id])
  @@index([engagementId, status, createdAt, id], map: "claims_by_status")
  @@map("claim")
}

model IdempotencyRecord {
  actorId      String @map("actor_id") @db.Uuid
  scope        String
  key          String
  requestHash  Bytes @map("request_hash")
  responseCode Int @map("response_code")
  responseBody Json? @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        AppUser @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([actorId, scope, key])
  @@map("idempotency_record")
}

model AuditEvent {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String? @map("company_id") @db.Uuid
  actorId     String? @map("actor_id") @db.Uuid
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id") @db.Uuid
  action      String
  details     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor       AppUser? @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("audit_event")
}

model Connection {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String @map("company_id") @db.Uuid
  provider        String
  environment     String
  externalAccount String @map("external_account")
  secretRef       String @map("secret_ref")
  status          String
  coverageFrom    DateTime? @map("coverage_from") @db.Timestamptz(6)
  lastDeliveryAt  DateTime? @map("last_delivery_at") @db.Timestamptz(6)
  reconciledAt    DateTime? @map("reconciled_at") @db.Timestamptz(6)
  importCursor    String? @map("import_cursor")
  company         Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mappings        ProductMapping[]
  authorities     SourceAuthority[]
  events          InboundEvent[]
  effects         SaleEffect[]
  gaps            CoverageGap[]

  @@unique([provider, environment, externalAccount])
  @@unique([companyId, id])
  @@map("connection")
}

model ProductMapping {
  companyId       String @map("company_id") @db.Uuid
  connectionId    String @map("connection_id") @db.Uuid
  externalProduct String @map("external_product")
  channel         String
  productId       String @map("product_id") @db.Uuid
  connection      Connection @relation(fields: [companyId, connectionId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  product         Product @relation(fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([connectionId, externalProduct, channel])
  @@map("product_mapping")
}

model SourceAuthority {
  companyId    String @map("company_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  channel      String
  connectionId String @map("connection_id") @db.Uuid
  environment  String
  connection   Connection @relation(fields: [companyId, connectionId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  product      Product @relation(fields: [companyId, productId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([productId, channel, environment])
  @@map("source_authority")
}

model InboundEvent {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId  String @map("connection_id") @db.Uuid
  externalEvent String @map("external_event")
  payload       Json
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  connection    Connection @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  effects       SaleEffect[]

  @@unique([connectionId, externalEvent])
  @@map("inbound_event")
}

model SaleEffect {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String @map("company_id") @db.Uuid
  connectionId        String @map("connection_id") @db.Uuid
  transactionKey      String @map("transaction_key")
  lineKey             String @map("line_key")
  effectKey           String @map("effect_key")
  kind                String
  originalEffectId    String? @map("original_effect_id") @db.Uuid
  originalExternalKey String? @map("original_external_key")
  externalProduct     String @map("external_product")
  externalCustomer    String @map("external_customer")
  channel             String
  occurredAt          DateTime @map("occurred_at") @db.Timestamptz(6)
  currency            String @db.Char(3)
  amountMinor         BigInt @map("amount_minor")
  basisMinor          BigInt? @map("basis_minor")
  sourceEventId       String? @map("source_event_id") @db.Uuid
  disposition         String
  connection          Connection @relation(fields: [companyId, connectionId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  sourceEvent         InboundEvent? @relation(fields: [sourceEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  originalEffect      SaleEffect? @relation("OriginalEffect", fields: [originalEffectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  relatedEffects      SaleEffect[] @relation("OriginalEffect")
  reviews             ReviewItem[]

  @@unique([connectionId, transactionKey, lineKey, effectKey])
  @@unique([companyId, id])
  @@map("sale_effect")
}

model ReviewItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String @map("company_id") @db.Uuid
  effectId    String @map("effect_id") @db.Uuid
  reason      String
  resolution  String?
  resolvedBy  String? @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)
  effect      SaleEffect @relation(fields: [companyId, effectId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  resolver    AppUser? @relation(fields: [resolvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("review_item")
}

model CoverageGap {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId String @map("connection_id") @db.Uuid
  startsAt     DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(6)
  reason       String
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("coverage_gap")
}
