NODE_ENV=development
DATABASE_URL=postgresql://repharbor:repharbor_local@127.0.0.1:5432/repharbor?schema=public
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
PORT=3000
WORKER_HEALTH_PORT=3001
SESSION_TTL_SECONDS=604800
MAIL_TRANSPORT=smtp
MAIL_FROM=RepHarbor <login@repharbor.test>
SMTP_URL=smtp://127.0.0.1:1025
# For deployed email set MAIL_TRANSPORT=resend and use a verified sender.
# RESEND_API_KEY=
# Development placeholder. Generate a unique key with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Set to the verified number of trusted proxies in a deployed environment.
TRUST_PROXY_HOPS=0
# Development can accept signed synthetic Stripe payloads for acct_fixture_* accounts.
SALES_ENVIRONMENT=test
ALLOW_LOCAL_PROVIDER_FIXTURES=true
