{
  "name": "@repharbor/api",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --exit-child src/main.ts",
    "dev:worker": "ts-node-dev --respawn --exit-child src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.12",
    "@nestjs/core": "^11.2.12",
    "@nestjs/platform-express": "^11.2.12",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.13",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.16.3",
    "@repharbor/contracts": "workspace:*",
    "swagger-ui-dist": "^5.36.0",
    "nodemailer": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "prisma": "7.10.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3",
    "@types/nodemailer": "^8.0.0"
  }
}
