{
  "name": "@repharbor/contracts",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "openapi-typescript ../../docs/technical/openapi.yaml -o src/wire.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./reference": {
      "types": "./dist/reference.d.ts",
      "browser": "./src/reference.ts",
      "default": "./dist/reference.js"
    }
  }
}
